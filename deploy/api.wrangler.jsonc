{
  "compatibility_date": "2026-09-01",
  "workers_dev": false,
  "observability": {
    "enabled": true
  },
  "limits": {
    "cpu_ms": 300000
  },
  "name": "wm-api",
  "main": "../dist/server/index.js",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "wm-api",
      "database_id": "REPLACE_WITH_DATABASE_ID"
    }
  ],
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  },
  "vars": {
    "WM_MODE": "tempo-mainnet",
    "WM_BOUNTY_ESCROW_VERSION": "4",
    "WM_BOUNTY_ESCROW_ADDRESS": "0x039019B527dBAffE6870CbD78C46c51479aF34a2",
    "WM_ESCROW_SETTLEMENT_SIGNER": "0xFF5CC569629540DF4D2b44a407EBb321Bd9c49e6",
    "WM_BOUNTY_RELAYER_ADDRESS": "0xCA57cA8E21670fCaD76aD6485223fc231fd020D5",
    "WM_TEMPO_RPC_URL": "https://rpc.tempo.xyz",
    "WM_TEMPO_SUPPORTED_TOKENS": "0x20C0000000000000000000000000000000000000,0x20C000000000000000000000b9537d11c60E8b50",
    "WM_TEMPO_SWAP_SLIPPAGE_BPS": "100",
    "WM_AGENT_BOUNTY_MPP_ENABLED": "false",
    "WM_AGENT_BOUNTY_MPP_MAX": "1.00",
    "WM_META_REPORT_INTERVAL_HOURS": "24",
    "WM_RESULT_SIGNING_READY": "false",
    "WM_EMERGENCY_PAUSE": "false",
    "SIGNER_ADDRESSES": "[]"
  },
  "services": [
    {
      "binding": "SIGNER_A",
      "service": "wm-signer-a"
    },
    {
      "binding": "SIGNER_B",
      "service": "wm-signer-b"
    },
    {
      "binding": "RELAY",
      "service": "wm-relay"
    }
  ],
  "secrets_store_secrets": [
    {
      "binding": "SIGNER_A_AUTH",
      "store_id": "REPLACE_WITH_STORE_ID",
      "secret_name": "wm-signer-a-auth"
    },
    {
      "binding": "SIGNER_B_AUTH",
      "store_id": "REPLACE_WITH_STORE_ID",
      "secret_name": "wm-signer-b-auth"
    },
    {
      "binding": "RELAY_AUTH",
      "store_id": "REPLACE_WITH_STORE_ID",
      "secret_name": "wm-relay-auth"
    },
    {
      "binding": "SIGNER_A_API_AUTH",
      "store_id": "REPLACE_WITH_STORE_ID",
      "secret_name": "wm-signer-a-api-auth"
    },
    {
      "binding": "SIGNER_B_API_AUTH",
      "store_id": "REPLACE_WITH_STORE_ID",
      "secret_name": "wm-signer-b-api-auth"
    },
    {
      "binding": "RELAY_API_AUTH",
      "store_id": "REPLACE_WITH_STORE_ID",
      "secret_name": "wm-relay-api-auth"
    },
    {
      "binding": "OPERATOR_AUTH",
      "store_id": "REPLACE_WITH_STORE_ID",
      "secret_name": "wm-operator-auth"
    },
    {
      "binding": "SCHEDULER_AUTH",
      "store_id": "REPLACE_WITH_STORE_ID",
      "secret_name": "wm-scheduler-auth"
    },
    {
      "binding": "MONITOR_AUTH",
      "store_id": "REPLACE_WITH_STORE_ID",
      "secret_name": "wm-monitor-auth"
    }
  ]
}
