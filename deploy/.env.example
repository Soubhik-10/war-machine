# PUBLIC CONFIGURATION ONLY. Do not place any private key or password in this file.
# Runtime credentials MUST be Secrets Store bindings (see *.wrangler.jsonc).
WM_MODE=tempo-mainnet
WM_BOUNTY_ESCROW_ADDRESS=0x039019B527dBAffE6870CbD78C46c51479aF34a2
WM_BOUNTY_ESCROW_VERSION=4
WM_ESCROW_SETTLEMENT_SIGNER=0xFF5CC569629540DF4D2b44a407EBb321Bd9c49e6
WM_BOUNTY_RELAYER_ADDRESS=0xCA57cA8E21670fCaD76aD6485223fc231fd020D5
WM_TEMPO_RPC_URL=https://rpc.tempo.xyz
# Optional comma-separated, operator-reviewed Tempo stablecoin inputs for MPP
# autoSwap. The escrow still receives pathUSD; never add an unreviewed token.
WM_TEMPO_SUPPORTED_TOKENS=0x20C0000000000000000000000000000000000000,0x20C000000000000000000000b9537d11c60E8b50
WM_TEMPO_SWAP_SLIPPAGE_BPS=100
WM_RESULT_SIGNING_READY=false
# Server-side V4 settlement signer key. Set this only in the hosting provider's Secret Store;
# never commit it or expose it to browsers.
# WM_SETTLEMENT_PRIVATE_KEY=
WM_EMERGENCY_PAUSE=false
SERVICE_ID=
SIGNER_ADDRESS=
SIGNER_ADDRESSES=
RELAY_ADDRESS=
MAX_RELAY_GAS=1000000
MAX_FEE_PER_GAS=100000000000
ACCESS_TEAM_DOMAIN=
ACCESS_AUDIENCE=
OPERATOR_EMAILS=
# Secret references required, with NO values:
# SIGNING_KEY: distinct existing approved key in each signer's dedicated store
# RELAY_KEY: dedicated relay key, not an escrow settlement signer
# COORDINATOR_AUTH / API_AUTH: directional, service-specific HMAC secrets
# API: SIGNER_A_AUTH, SIGNER_B_AUTH, RELAY_AUTH,
#      SIGNER_A_API_AUTH, SIGNER_B_API_AUTH, RELAY_API_AUTH,
#      OPERATOR_AUTH, SCHEDULER_AUTH, MONITOR_AUTH
# Monitor: ALERT_WEBHOOK (HTTPS notification webhook)
# Bindings: API, SIGNER_A, SIGNER_B, RELAY, RELAY_ACTOR, DB, METRICS
MIN_RELAY_FEE_BALANCE=1000000
