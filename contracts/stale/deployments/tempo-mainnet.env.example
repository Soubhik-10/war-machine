# Tempo Mainnet Bounty Escrow deployment template. Do not put a private key here.
# The deploy command uses an interactive, operator-controlled signer.
WM_ESCROW_PAUSE_GUARDIAN=0x0000000000000000000000000000000000000000
WM_ESCROW_SIGNER_COUNT=2
WM_ESCROW_SIGNER_QUORUM=2
WM_ESCROW_SIGNER_1=0x0000000000000000000000000000000000000000
WM_ESCROW_SIGNER_2=0x0000000000000000000000000000000000000000
# 3–5 minutes to build, then enough time for two signatures and relay.
WM_ESCROW_ATTEMPT_WINDOW_SECONDS=600
