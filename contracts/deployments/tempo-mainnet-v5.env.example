# Public values only. Keep this example safe to commit.
WM_ESCROW_PAUSE_GUARDIAN=0xREPLACE_WITH_ZERO_BALANCE_GUARDIAN
WM_ESCROW_AGENT_RELAYER=0xREPLACE_WITH_BOUNDED_AGENT_RELAYER
WM_ESCROW_SETTLEMENT_SIGNER=0xREPLACE_WITH_AUTOMATION_WALLET_ADDRESS
WM_ESCROW_ATTEMPT_WINDOW_SECONDS=600
# V5 accepts a valid result during this fixed two-minute relay grace.
# It also exposes reopenTimedOutAttempt for infrastructure recovery; this does
# not refund the already-direct entry or classify the challenger as a loser.
